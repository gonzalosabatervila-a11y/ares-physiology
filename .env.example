# ARES Physiology — configuración no secreta. Copiar a .env solo si se quiere cambiar algo:
# sin .env se usan estos valores por defecto.
# Los secretos NUNCA van aquí: se guardan con `ares secret set <clave>` (Llavero / Credenciales de Windows).

ARES_DATA_DIR=~/ares-data          # en el HP de producción: C:\ares-data (fuera de cualquier sincronización)
ARES_TZ=Europe/Madrid
ARES_RULES_VERSION=1.2
PHYSIOLOGY_PROVIDER=whoop
INTERVALS_WELLNESS_DEVICE=COROS    # procedencia declarada del wellness de Intervals; no verificable por la API          # proveedor activo (adaptador)
# Identidad estable de la unidad, no del fabricante: otra unidad, aunque sea WHOOP, abre línea base nueva
ARES_DEVICE_ID=pulsera-principal
ARES_ALGO_VERSION=whoop-1
INTERVALS_ATHLETE_ID=0
BACKFILL_MAX_DAYS=30
WHOOP_REDIRECT_URI=http://localhost:8765/callback   # la misma, exacta, en el panel de WHOOP
WHOOP_HISTORY_DAYS=90              # carga histórica inicial: mínimo objetivo

# Opcional: peso actualizado para convertir rangos Fueling ARES (g/kg) a gramos/día.
# Configurarlo SOLO en ~/ares/.env local. No publicar el peso real en Git.
# ARES_NUTRITION_WEIGHT_KG=

# Dirección de la app local (solo el propio equipo; Tailscale Serve la publica en tu red privada)
APP_BIND=127.0.0.1:8443
# Prefijo público y contrato de autenticación cuando ARES vive tras GonzaloOS.
ARES_PUBLIC_BASE_PATH=
ARES_PROXY_AUTH_REQUIRED=0
ARES_SECRETS_DIR=/run/secrets/ares
ARES_SECRET_STATE_DIR=
